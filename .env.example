# ─────────────────────────────────────────────────────────────
# Prism Frontend Environment Variables
# ─────────────────────────────────────────────────────────────
#
# IMPORTANT for cross-device / LAN testing:
#   Set VITE_API_URL to the machine running the backend server.
#   e.g. if the backend server's LAN IP is 192.168.1.5:
#        VITE_API_URL=http://192.168.1.5:8000
#
# For same-device development (default):
VITE_API_URL=http://localhost:8000
